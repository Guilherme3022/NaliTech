# ===== Banco de dados (Postgres) =====
DB_URL=jdbc:postgresql://postgres:5432/nalitech
DB_USER=nalitech
DB_PASSWORD=nalitech

# ===== Cache (Redis) =====
REDIS_HOST=redis
REDIS_PORT=6379

# ===== Fila (RabbitMQ) =====
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=nalitech
RABBITMQ_PASSWORD=nalitech

# ===== Storage S3-compatible (MinIO local / Cloudflare R2 em producao) =====
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=nalitech
STORAGE_SECRET_KEY=nalitech123
STORAGE_BUCKET=nalitech-files
STORAGE_REGION=us-east-1

# ===== JWT =====
JWT_SECRET=troque-isso-por-um-segredo-forte
# Access token (segundos). Curto: o front renova automaticamente em atividade.
JWT_EXPIRATION=900
# Refresh token = janela de inatividade (idle). 7200s = desloga apos ~2h parado.
JWT_REFRESH_EXPIRATION=7200

# ===== CORS (dominio do frontend) =====
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ===== Rate limiting (endpoints publicos) =====
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_SECONDS=60

# ===== E-mail (SMTP) =====
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@nalitech.local
OFFICE_NOTIFICATION_EMAIL=escritorio@nalitech.local

# ===== IA (sugestao de conta contabil) =====
# HEURISTICA (padrao, custo zero) ou IA (usa um LLM). Ver DEPLOY.md secao 5.
AI_PROVIDER=HEURISTICA
# Endpoint compativel com a API da OpenAI (OpenAI, Groq, OpenRouter, Ollama...)
AI_API_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...            # se vazio, cai automaticamente na heuristica
AI_MODEL=gpt-4o-mini

# ===== Gateway de pagamento =====
PAYMENT_PROVIDER=SIMULADO
# ASAAS_API_TOKEN=...
# PAYMENT_WEBHOOK_SECRET=...

# ===== Usuario admin inicial (primeira subida) =====
DEFAULT_ADMIN_EMAIL=admin@nalitech.local
DEFAULT_ADMIN_PASSWORD=admin123

# ===== Criptografia de dados sensiveis em repouso (32 chars) =====
NALITECH_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# ==========================================================================
# .env.prod.example — modelo de producao (Oracle Always Free)
#
# COMO USAR (na VM):
#   cp .env.prod.example .env.prod
#   nano .env.prod            # preencha os valores reais
#
# NUNCA commite o .env.prod real (so este .example, com placeholders).
# Base: DEPLOY.md secoes 3.a/3.b/3.c/3.d.
# ==========================================================================

# ===== Banco — Neon (Postgres gerenciado) — DEPLOY.md 3.a =====
# Cole a connection string do Neon (mantenha ?sslmode=require).
DB_URL=jdbc:postgresql://SEU_HOST_NEON/SEU_DB?sslmode=require
DB_USER=SEU_USER_NEON
DB_PASSWORD=SUA_SENHA_NEON

# ===== Storage — Cloudflare R2 (S3-compatible) — DEPLOY.md 3.b =====
STORAGE_ENDPOINT=https://SEU_ACCOUNTID.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=SUA_ACCESS_KEY_R2
STORAGE_SECRET_KEY=SUA_SECRET_KEY_R2
STORAGE_BUCKET=SEU_BUCKET
STORAGE_REGION=auto

# ===== Seguranca obrigatoria — DEPLOY.md 3.d =====
# Gere na VM:
#   openssl rand -hex 24    -> JWT_SECRET (>=32 chars)
#   openssl rand -hex 16    -> NALITECH_ENCRYPTION_KEY (EXATAMENTE 32 chars)
#   openssl rand -base64 18 -> DEFAULT_ADMIN_PASSWORD
JWT_SECRET=COLE_O_JWT_SECRET_FORTE_MIN_32
NALITECH_ENCRYPTION_KEY=COLE_A_CHAVE_DE_32_CHARS_EXATOS
DEFAULT_ADMIN_EMAIL=admin@nalisystems.com
DEFAULT_ADMIN_PASSWORD=COLE_A_SENHA_ADMIN_FORTE

# ===== Health: sem Redis/RabbitMQ em producao — DEPLOY.md 3.c =====
REDIS_HEALTH_ENABLED=false
RABBIT_HEALTH_ENABLED=false

# ===== CORS — dominio do frontend — DEPLOY.md 3.6 =====
# Preencher DEPOIS do deploy do frontend na Vercel (URL exata, https://, sem barra final).
CORS_ALLOWED_ORIGINS=https://nalisystems.com

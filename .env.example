# ===== Banco de dados (Postgres) =====
DB_URL=jdbc:postgresql://postgres:5432/ledgerflow
DB_USER=ledgerflow
DB_PASSWORD=ledgerflow

# ===== Cache (Redis) =====
REDIS_HOST=redis
REDIS_PORT=6379

# ===== Fila (RabbitMQ) =====
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=ledgerflow
RABBITMQ_PASSWORD=ledgerflow

# ===== Storage S3-compatible (MinIO local / Cloudflare R2 em producao) =====
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=ledgerflow
STORAGE_SECRET_KEY=ledgerflow123
STORAGE_BUCKET=ledgerflow-files
STORAGE_REGION=us-east-1

# ===== JWT =====
JWT_SECRET=troque-isso-por-um-segredo-forte
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=2592000

# ===== CORS (dominio do frontend) =====
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ===== Rate limiting (endpoints publicos) =====
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_SECONDS=60

# ===== E-mail (SMTP) =====
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@ledgerflow.local
OFFICE_NOTIFICATION_EMAIL=escritorio@ledgerflow.local

# ===== Gateway de pagamento =====
PAYMENT_PROVIDER=SIMULADO
# ASAAS_API_TOKEN=...
# PAYMENT_WEBHOOK_SECRET=...

# ===== Usuario admin inicial (primeira subida) =====
DEFAULT_ADMIN_EMAIL=admin@ledgerflow.local
DEFAULT_ADMIN_PASSWORD=admin123

# ===== Criptografia de dados sensiveis em repouso (32 chars) =====
LEDGERFLOW_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
